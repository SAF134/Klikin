<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_dock_root"
    android:layout_width="60dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_dock"
    android:gravity="center_horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Drag Handle (Area khusus untuk menggeser dock) -->
    <LinearLayout
        android:id="@+id/dock_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="Drag handle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="::::"
            android:textColor="@color/klikin_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:background="@color/klikin_stroke_subtle"
        android:layout_marginBottom="6dp" />

    <!-- 1. Tombol Mulai / Berhenti (Play / Pause) -->
    <FrameLayout
        android:id="@+id/btn_play_pause"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:clickable="true"
        android:focusable="false"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <View
            android:id="@+id/btn_play_pause_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_btn_play" />

        <TextView
            android:id="@+id/btn_play_pause_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="▶"
            android:textColor="@color/klikin_text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 2. Tombol Pengaturan ke Aplikasi (⚙) -->
    <FrameLayout
        android:id="@+id/btn_settings"
        android:layout_width="56dp"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="false"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⚙"
            android:textColor="@color/klikin_text_secondary"
            android:textSize="22sp" />
    </FrameLayout>

    <!-- 3. Tombol Minimize (‹) -->
    <FrameLayout
        android:id="@+id/btn_minimize"
        android:layout_width="56dp"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="false"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="‹"
            android:textColor="@color/klikin_text_secondary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="40dp"
        android:layout_height="1dp"
        android:background="@color/klikin_stroke_subtle"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <!-- 4. Tombol Keluar (✕) -->
    <FrameLayout
        android:id="@+id/btn_close"
        android:layout_width="56dp"
        android:layout_height="52dp"
        android:clickable="true"
        android:focusable="false"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✕"
            android:textColor="@color/klikin_crimson_stop"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
