<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/target_pin_root"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="false">

    <!-- Reticle Crosshair Lines (Garis bidik presisi horizontal & vertikal 56dp) -->
    <View
        android:layout_width="56dp"
        android:layout_height="2dp"
        android:layout_gravity="center"
        android:background="#B3000000" />

    <View
        android:layout_width="2dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="#B3000000" />

    <!-- Outer dual-ring circular badge (Diperbesar ke 48dp agar mudah disentuh & presisi) -->
    <FrameLayout
        android:id="@+id/target_pin_badge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_target_pin">

        <!-- Target Index Number -->
        <TextView
            android:id="@+id/tv_target_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
